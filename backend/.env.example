GROQ_API_KEY="your_groq_api_key_here"
TAVILY_API_KEY="your_tavily_api_key_here"

# Optional overrides
# PLANNER_MODEL="openai/gpt-oss-120b"
# PLANNER_REASONING_EFFORT="low"        # low | medium | high ("" = provider default)
# PLANNER_MAX_RETRIES=4                 # retries on Groq rate limits / transient errors
# PLANNER_TIMEOUT=120                   # seconds per LLM call
# PLANNER_DB="data/planner.db"          # relative paths resolve against backend/
# CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
